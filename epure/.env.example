# Copie ce fichier en ".env" puis remplis les valeurs.
# Le Client ID Spotify n'est pas un secret (flux PKCE, sans Client Secret).
VITE_SPOTIFY_CLIENT_ID=9187c9dc1b274203932e2503ec186f3d

# Clé API Last.fm gratuite (https://www.last.fm/api/account/create).
# Laisse vide pour désactiver la découverte de nouveaux titres.
VITE_LASTFM_API_KEY=
